# ------------------------------
# Global
# ------------------------------
TZ=Europe/Paris

# ------------------------------
# PostgreSQL
# ------------------------------
POSTGRES_PORT=5433
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# Client connection helpers (optional)
PGHOST=localhost
PGPORT=5433
PGDATABASE=airflow
PGUSER=airflow
PGPASSWORD=airflow

# ------------------------------
# MinIO
# ------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_RAW_API=raw-api
MINIO_BUCKET_RAW_SCRAP=raw-scrap
MINIO_SECURE=false

# ------------------------------
# Airflow
# ------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:2.7.3
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=False
AIRFLOW_DB_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW_WEBSERVER_PORT=8088
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=admin
AIRFLOW_ADMIN_LASTNAME=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADDITIONAL_REQUIREMENTS=minio psycopg2-binary

# ------------------------------
# Monitoring
# ------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------
# France Travail API
# ------------------------------
FRANCE_TRAVAIL_CLIENT_ID=your_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_SEARCH_URL=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
FRANCE_TRAVAIL_TIMEOUT_SECONDS=20

# ------------------------------
# Welcome To The Jungle Scraper
# ------------------------------
WTTJ_BASE_URL=https://www.welcometothejungle.com
WTTJ_TIMEOUT_SECONDS=20
WTTJ_USER_AGENT=Mozilla/5.0 (compatible; job-market-etl-factory/1.0)
